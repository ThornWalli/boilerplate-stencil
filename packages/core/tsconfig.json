{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "allowUnreachableCode": false,
    "declaration": false,
    "experimentalDecorators": true,
    "lib": [
      "dom",
      "es2022",
      "es2024"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2024",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "h.Fragment",
    "baseUrl": ".",
    "paths": {
      "@boilerplate-stencil/utilities/*": [
        "../utilities/src/*"
      ]
    }
  },

  "include": ["src"],
  "exclude": [
    "node_modules"
  ]
}
