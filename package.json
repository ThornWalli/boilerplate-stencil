{
  "name": "boilerplate-stencil",
  "version": "0.0.1",
  "description": "Boilerplate Stencil",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/boilerplate-stencil/boilerplate-stencil.esm.js",
  "exports": {
    ".": {
      "import": "./dist/boilerplate-stencil/boilerplate-stencil.esm.js",
      "require": "./dist/boilerplate-stencil/boilerplate-stencil.cjs.js"
    },
    "./my-component": {
      "import": "./dist/components/my-component.js",
      "types": "./dist/components/my-component.d.ts"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ThornWalli/boilerplate-stencil.git"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "prepare": "husky || true",
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil-test",
    "test:watch": "stencil-test --watch",
    "test:e2e": "stencil-test --project browser",
    "test:spec": "stencil-test --project spec",
    "lint": "pnpm run -r prepare && pnpm run lint:es && pnpm run lint:css",
    "lint:es": "npx --node-options='--experimental-strip-types' eslint --flag unstable_native_nodejs_ts_config .",
    "lint:css": "stylelint \"**/*.{css,pcss}\"",
    "generate": "stencil generate"
  },
  "peerDependencies": {
    "ckeditor5": ">=44.0.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.4.1",
    "@stencil-community/postcss": "2.2.0",
    "@types/jest": "^30.0.0",
    "@stencil/core": "4.42.1",
    "@stencil/vitest": "1.1.7",
    "@types/node": "25.2.1",
    "@types/postcss-import": "^14.0.3",
    "@vitest/browser-playwright": "4.0.18",
    "commitlint": "^20.4.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-security": "3.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss-html": "^1.8.1",
    "postcss-import": "16.1.1",
    "postcss-preset-env": "11.1.3",
    "postcss-sort-media-queries": "5.2.0",
    "stylelint": "17.1.1",
    "stylelint-config-recess-order": "7.6.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-prettier": "^5.0.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  },
  "license": "MIT",
  "dependencies": {}
}
