{
  "name": "boilerplate-stencil",
  "version": "0.0.1",
  "description": "Boilerplate Stencil",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ThornWalli/boilerplate-stencil.git"
  },
  "scripts": {
    "prepare": "husky || true",
    "lint": "pnpm run lint:es && pnpm run lint:style",
    "lint:es": "eslint --flag unstable_native_nodejs_ts_config .",
    "lint:style": "pnpm run -r lint:style"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "20.4.2",
    "@types/eslint-plugin-security": "3.0.1",
    "@types/node": "25.3.0",
    "commitlint": "20.4.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import-x": "4.16.1",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-security": "4.0.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "typescript-eslint": "8.56.1"
  },
  "license": "MIT",
  "workspaces": [
    "./packages/*"
  ]
}
