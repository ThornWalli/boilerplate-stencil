{
  "name": "boilerplate-stencil",
  "version": "0.0.1",
  "description": "Boilerplate Stencil",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/boilerplate-stencil/boilerplate-stencil.esm.js",
  "exports": {
    ".": {
      "import": "./dist/boilerplate-stencil/boilerplate-stencil.esm.js",
      "require": "./dist/boilerplate-stencil/boilerplate-stencil.cjs.js"
    },
    "./my-component": {
      "import": "./dist/components/my-component.js",
      "types": "./dist/components/my-component.d.ts"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ThornWalli/boilerplate-stencil.git"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil-test",
    "test:watch": "stencil-test --watch",
    "test:e2e": "stencil-test --project browser",
    "test:spec": "stencil-test --project spec",
    "generate": "stencil generate"
  },
  "devDependencies": {
    "@stencil-community/postcss": "2.2.0",
    "@stencil/core": "4.42.0",
    "@stencil/vitest": "1.1.5",
    "@types/node": "25.2.1",
    "@vitest/browser-playwright": "4.0.18",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-security": "3.0.1",
    "postcss-import": "16.1.1",
    "postcss-preset-env": "11.1.3",
    "postcss-sort-media-queries": "5.2.0",
    "stylelint": "17.1.1",
    "stylelint-config-recess-order": "7.6.0",
    "stylelint-config-standard": "40.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "ckeditor5": "47.4.0"
  }
}
